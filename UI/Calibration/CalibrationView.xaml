<UserControl x:Class="AntarTechControl.UI.Calibration.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1160">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16.0" To="0.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <!-- Action Button Style (Glass matte) -->
        <Style x:Key="CalibActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#171926"/>
            <Setter Property="Foreground" Value="#E1E4EA"/>
            <Setter Property="BorderBrush" Value="#2A2E44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222638"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C3FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10121C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick 1-Click Calibration Button Style -->
        <Style x:Key="QuickSetBtn" TargetType="Button" BasedOn="{StaticResource CalibActionBtn}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Nudge Stepper Button (+ / -) -->
        <Style x:Key="NudgeBtn" TargetType="Button" BasedOn="{StaticResource CalibActionBtn}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00C3FF"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5,10,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1. TOP HEADER BAR (Glass styling)                            -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderBrush="#252A3E" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6121422" Offset="0"/>
                    <GradientStop Color="#E6181B2C" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Device Info and Breadcrumb Back Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NavigateToDashboardCommand}" 
                            Background="#181B2A" BorderBrush="#2A2F45" BorderThickness="1" 
                            Padding="12,8" Margin="0,0,16,0" Cursor="Hand" ToolTip="Volver al Hub de Dispositivos">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="←" Foreground="#00C3FF" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L.CalibBack}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#0C0E18" BorderBrush="#202436" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Image Source="pack://application:,,,/logo_crisp.png" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                            <Border Background="#101E2E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" BorderBrush="#1C3852" BorderThickness="1">
                                <TextBlock Text="{Binding SelectedDevice.Subtitle}" FontSize="10" FontWeight="Bold" Foreground="#00C3FF"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L.ConnectedDirectInput}" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding L.CalibGuide}" Command="{Binding NavigateToTutorialCommand}" Style="{StaticResource CalibActionBtn}" Margin="0,0,10,0" ToolTip="Ver tutorial de cómo calibrar"/>
                    <Button Content="{Binding L.CalibSaveWindows}" Command="{Binding ApplyToWindowsCommand}" Style="{StaticResource ApplyBtn}" Margin="0,0,10,0" ToolTip="Guarda la calibración en el Registro de Windows para todos los juegos."/>
                    <Button Content="{Binding L.CalibReload}" Command="{Binding ReloadFromWindowsCommand}" Style="{StaticResource CalibActionBtn}" Margin="0,0,6,0" ToolTip="Lee los valores actuales guardados en Windows."/>
                    <Button Content="{Binding L.CalibReset}" Command="{Binding ResetWindowsCalibrationCommand}" Style="{StaticResource CalibActionBtn}" ToolTip="Vuelve a los rangos nativos del dispositivo."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. MAIN 2-COLUMN SPLIT: ALL AXES (LEFT) + DXTWEAK TUNING (RIGHT) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- LEFT PANEL: ALL AXES TABLE + DUAL-INDICATOR GRADUATED BARS   -->
            <!-- ============================================================ -->
            <Border Grid.Column="0" CornerRadius="12" Padding="18" Margin="0,0,16,0" BorderBrush="#22263A" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D9111320" Offset="0"/>
                        <GradientStop Color="#D9151828" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header & Dual Indicator Legend (DXTweak style) -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L.CalibAxesTitle}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding L.CalibAxesDesc}" FontSize="11" Foreground="#8E93A3" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Legend matching DXTweak -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1C1822" CornerRadius="4" Padding="7,4" Margin="0,0,10,0" BorderBrush="#3B1822" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▼" Foreground="#EF4444" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding L.LegendRaw}" Foreground="#FCA5A5" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#10202E" CornerRadius="4" Padding="7,4" BorderBrush="#1C3852" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▲" Foreground="#00C3FF" FontSize="10" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding L.LegendDirectInput}" Foreground="#7DD3FC" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Axes List ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CurrentAxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Clickable Card for each axis -->
                                    <Button Command="{Binding DataContext.SelectAxisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,0,12" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CardBox" CornerRadius="10" Padding="16,14" BorderBrush="#202436" BorderThickness="1" Background="#141624">
                                                    <Border.ContextMenu>
                                                        <ContextMenu Background="#141624" BorderBrush="#202436" Foreground="#FFFFFF">
                                                            <MenuItem Header="Asignar: Acelerador" Command="{Binding SetRoleCommand}" CommandParameter="Acelerador"/>
                                                            <MenuItem Header="Asignar: Freno" Command="{Binding SetRoleCommand}" CommandParameter="Freno"/>
                                                            <MenuItem Header="Asignar: Embrague" Command="{Binding SetRoleCommand}" CommandParameter="Embrague"/>
                                                            <MenuItem Header="Asignar: Freno de Mano" Command="{Binding SetRoleCommand}" CommandParameter="Freno de Mano"/>
                                                            <MenuItem Header="Asignar: Volante" Command="{Binding SetRoleCommand}" CommandParameter="Volante"/>
                                                            <Separator Background="#24283C"/>
                                                            <MenuItem Header="Asignar: Genérico" Command="{Binding SetRoleCommand}" CommandParameter="Generico"/>
                                                            <Separator Background="#24283C"/>
                                                            <MenuItem Header="⇄ Invertir Dirección (Swap Mín/Máx)" Command="{Binding InvertAxisCommand}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel>
                                                        <!-- Row 1: Axis Title, Status, and Live Values -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Title & Role -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{Binding RoleColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Border Background="#181B2A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="#8E93A3"/>
                                                                </Border>
                                                                <Border Background="#102A24" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsCalibratedInWindows, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding DataContext.L.StatusInWindows, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Real-time Live Numbers (Value & Raw) -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                                    <TextBlock Text="DirectInput: " FontSize="11" Foreground="#8E93A3" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding WindowsCalibratedValue}" FontSize="13" FontWeight="Bold" Foreground="#00C3FF" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding WindowsCalibratedPercent, StringFormat=' ({0:F0}%)'}" FontSize="11" FontWeight="SemiBold" Foreground="#00C3FF" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Raw: " FontSize="11" Foreground="#8E93A3" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding RawValue}" FontSize="13" FontWeight="Bold" Foreground="#EF4444" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: DXTweak Dual-Indicator Graduated Scale Bar -->
                                                        <Grid Height="34" Margin="0,2,0,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="12"/>
                                                                <RowDefinition Height="10"/>
                                                                <RowDefinition Height="12"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Top Row: Red Triangle ▼ (Hardware Raw Sensor) -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding RawPercent, Converter={StaticResource PercentToGridLength}}"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="{Binding RawPercent, Converter={StaticResource InversePercentToGridLength}}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Polygon Grid.Column="1" Points="0,0 8,0 4,8" Fill="#EF4444" Margin="-4,0,0,0"/>
                                                            </Grid>

                                                            <!-- Middle Row: Graduated Scale Bar with ticks & active fill -->
                                                            <Border Grid.Row="1" Background="#0C0D16" BorderBrush="#25283C" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                                                <Grid>
                                                                    <!-- Tick lines across the bar -->
                                                                    <Path Stroke="#1C1F32" StrokeThickness="1" SnapsToDevicePixels="True"
                                                                          Data="M 0,0 L 0,10 M 40,0 L 40,10 M 80,0 L 80,10 M 120,0 L 120,10 M 160,0 L 160,10 M 200,0 L 200,10 M 240,0 L 240,10 M 280,0 L 280,10 M 320,0 L 320,10 M 360,0 L 360,10 M 400,0 L 400,10 M 440,0 L 440,10 M 480,0 L 480,10 M 520,0 L 520,10 M 560,0 L 560,10 M 600,0 L 600,10 M 640,0 L 640,10"/>
                                                                    <!-- Calibrated Fill bar -->
                                                                    <ProgressBar Value="{Binding WindowsCalibratedPercent}" Maximum="100" Style="{StaticResource NeonProgressBar}" Height="8" Background="Transparent" BorderThickness="0"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Bottom Row: Cyan Triangle ▲ (DirectInput Windows Output) -->
                                                            <Grid Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="{Binding WindowsCalibratedPercent, Converter={StaticResource PercentToGridLength}}"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="{Binding WindowsCalibratedPercent, Converter={StaticResource InversePercentToGridLength}}"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Polygon Grid.Column="1" Points="4,0 0,8 8,8" Fill="#00C3FF" Margin="-4,0,0,0"/>
                                                            </Grid>
                                                        </Grid>

                                                        <!-- Row 3: Live DXTweak Matrix Values + 1-Click Quick Buttons -->
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Calibration Matrix Values Strip -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <StackPanel Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding DataContext.L.MinLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9" FontWeight="Bold" Foreground="#6E7385"/>
                                                                    <TextBlock Text="{Binding Min}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding DataContext.L.CtrLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9" FontWeight="Bold" Foreground="#6E7385"/>
                                                                    <TextBlock Text="{Binding Center}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding DataContext.L.MaxLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9" FontWeight="Bold" Foreground="#6E7385"/>
                                                                    <TextBlock Text="{Binding Max}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DataContext.L.DeadzoneLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9" FontWeight="Bold" Foreground="#6E7385"/>
                                                                    <TextBlock Text="{Binding Deadzone, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" Foreground="#00C3FF" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- 1-Click Quick Buttons on EVERY Axis (No tab switching needed!) -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="{Binding DataContext.L.SetMinBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding SetMinCommand}" Style="{StaticResource QuickSetBtn}" Margin="0,0,6,0" ToolTip="Fija el Mínimo con el pedal en reposo"/>
                                                                <Button Content="{Binding DataContext.L.SetCenterBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding SetCenterCommand}" Style="{StaticResource QuickSetBtn}" Margin="0,0,6,0" ToolTip="Fija el Centro neutro"/>
                                                                <Button Content="{Binding DataContext.L.SetMaxBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding SetMaxCommand}" Style="{StaticResource QuickSetBtn}" Margin="0,0,6,0" ToolTip="Fija el Máximo con el pedal a fondo"/>
                                                                <Button Content="{Binding DataContext.L.InvertBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding InvertAxisCommand}" Style="{StaticResource QuickSetBtn}" Margin="0,0,6,0" ToolTip="{Binding DataContext.L.InvertTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                <Button Content="{Binding DataContext.L.ResetBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding ResetCommand}" Style="{StaticResource QuickSetBtn}" ToolTip="Restaura a valores nativos"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBox" Property="BorderBrush" Value="#00C3FF"/>
                                                        <Setter TargetName="CardBox" Property="Background" Value="#181B2C"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="CardBox" Property="BorderBrush" Value="#00C3FF"/>
                                                        <Setter TargetName="CardBox" Property="Background" Value="#1C2036"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- RIGHT PANEL: DXTWEAK PRECISION TUNING & RESPONSE GRAPH       -->
            <!-- ============================================================ -->
            <Border Grid.Column="1" CornerRadius="12" Padding="18" BorderBrush="#22263A" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E6121422" Offset="0"/>
                        <GradientStop Color="#E617192A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Header with selected axis info -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding L.PrecisionTuning}" FontSize="11" FontWeight="Bold" Foreground="#8E93A3"/>
                                <TextBlock Text="{Binding SelectedAxis.DisplayTitle}" FontSize="18" FontWeight="Bold" Foreground="#00C3FF" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#141828" CornerRadius="4" Padding="8,4" BorderBrush="#252B42" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedAxis.Name}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </DockPanel>

                        <!-- Selector de Función / Rol del Eje -->
                        <Border Background="#10121E" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="#1F2336" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding DataContext.L.AxisRoleTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" FontWeight="Bold" Foreground="#8E93A3"/>
                                    <TextBlock Text="{Binding DataContext.L.AxisRoleSub, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Foreground="#52586D"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding SelectedAxis.Roles}" 
                                          SelectedItem="{Binding SelectedAxis.Role, Mode=TwoWay}"
                                          Style="{StaticResource GHubComboBox}" 
                                          Height="34"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Cartesian Response Curve Graph (DirectInput vs Raw) -->
                        <Border Height="190" Background="#0A0B12" BorderBrush="#202438" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                            <Grid>
                                <!-- 10x10 Grid Lines -->
                                <Path Stroke="#141724" StrokeThickness="1" SnapsToDevicePixels="True"
                                      Data="M 0,19 L 340,19 M 0,38 L 340,38 M 0,57 L 340,57 M 0,76 L 340,76 M 0,95 L 340,95 M 0,114 L 340,114 M 0,133 L 340,133 M 0,152 L 340,152 M 0,171 L 340,171
                                            M 34,0 L 34,190 M 68,0 L 68,190 M 102,0 L 102,190 M 136,0 L 136,190 M 170,0 L 170,190 M 204,0 L 204,190 M 238,0 L 238,190 M 272,0 L 272,190 M 306,0 L 306,190"/>
                                
                                <!-- Diagonal 45-deg reference guideline -->
                                <Line X1="0" Y1="190" X2="340" Y2="0" Stroke="#1B2032" StrokeThickness="1" StrokeDashArray="3 3"/>

                                <!-- Active Response Line -->
                                <Polyline Points="{Binding SelectedAxis.CurvePoints}" Stroke="#00C3FF" StrokeThickness="2.5" Stretch="Fill"/>

                                <!-- Real-Time Operating Point Beacon (Tracks pedal press) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding SelectedAxis.CurrentDotX, Converter={StaticResource PercentToGridLength}}"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="{Binding SelectedAxis.CurrentDotX, Converter={StaticResource InversePercentToGridLength}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding SelectedAxis.CurrentDotY, Converter={StaticResource PercentToGridLength}}"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="{Binding SelectedAxis.CurrentDotY, Converter={StaticResource InversePercentToGridLength}}"/>
                                    </Grid.RowDefinitions>

                                    <!-- Beacon Dot -->
                                    <Border Grid.Row="1" Grid.Column="1" Width="10" Height="10" CornerRadius="5" Background="#FFFFFF" BorderBrush="#00C3FF" BorderThickness="2" Margin="-5,-5,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#00C3FF" Opacity="0.95" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>

                                <!-- Coordinate Labels -->
                                <TextBlock Text="DirectInput: 65535" Foreground="#52586D" FontSize="9" Margin="6,4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="DirectInput: 0" Foreground="#52586D" FontSize="9" Margin="6,4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Text="Raw Mín" Foreground="#52586D" FontSize="9" Margin="65,4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <TextBlock Text="Raw Máx" Foreground="#52586D" FontSize="9" Margin="6,4" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <!-- Precision Steppers / Inputs (DXTweak Spinners) -->
                        <Border Background="#10121E" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" BorderBrush="#1F2336" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding L.NumericalCalib}" FontSize="11" FontWeight="Bold" Foreground="#8E93A3" Margin="0,0,0,10"/>

                                <!-- Mínimo -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mínimo:" FontSize="12" Foreground="#8E93A3" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedAxis.Min, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AntarTextBox}" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="-" Command="{Binding SelectedAxis.DecMinCommand}" Style="{StaticResource NudgeBtn}" Margin="0,0,4,0"/>
                                        <Button Content="+" Command="{Binding SelectedAxis.IncMinCommand}" Style="{StaticResource NudgeBtn}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Centro -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Centro:" FontSize="12" Foreground="#8E93A3" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedAxis.Center, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AntarTextBox}" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="-" Command="{Binding SelectedAxis.DecCenterCommand}" Style="{StaticResource NudgeBtn}" Margin="0,0,4,0"/>
                                        <Button Content="+" Command="{Binding SelectedAxis.IncCenterCommand}" Style="{StaticResource NudgeBtn}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Máximo -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Máximo:" FontSize="12" Foreground="#8E93A3" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedAxis.Max, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AntarTextBox}" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="-" Command="{Binding SelectedAxis.DecMaxCommand}" Style="{StaticResource NudgeBtn}" Margin="0,0,4,0"/>
                                        <Button Content="+" Command="{Binding SelectedAxis.IncMaxCommand}" Style="{StaticResource NudgeBtn}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Zona Muerta % -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Deadzone:" FontSize="12" Foreground="#8E93A3" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SelectedAxis.Deadzone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AntarTextBox}" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="-" Command="{Binding SelectedAxis.DecDeadzoneCommand}" Style="{StaticResource NudgeBtn}" Margin="0,0,4,0"/>
                                        <Button Content="+" Command="{Binding SelectedAxis.IncDeadzoneCommand}" Style="{StaticResource NudgeBtn}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Invertir Eje (Swap Mín/Máx) -->
                                <Button Content="{Binding DataContext.L.InvertBtn, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Command="{Binding SelectedAxis.InvertAxisCommand}" 
                                        Style="{StaticResource CalibActionBtn}" 
                                        Margin="0,12,0,0" 
                                        Height="32"
                                        ToolTip="{Binding DataContext.L.InvertTooltip, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
