<Window x:Class="AntarTechControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AntarTechControl"
        xmlns:vm="clr-namespace:AntarTechControl.ViewModels"
        xmlns:cal="clr-namespace:AntarTechControl.UI.Calibration"
        xmlns:dash="clr-namespace:AntarTechControl.UI.Dashboard"
        xmlns:set="clr-namespace:AntarTechControl.UI.Settings"
        mc:Ignorable="d"
        Title="ANTARTECH CONTROL" Height="800" Width="1050"
        Background="#0A0512" Foreground="White"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Icon="logo.png">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- View Templates -->
        <DataTemplate x:Key="CalibrationTemplate">
            <cal:CalibrationView />
        </DataTemplate>
        <DataTemplate x:Key="DashboardTemplate">
            <dash:DashboardView />
        </DataTemplate>
        <DataTemplate x:Key="SettingsTemplate">
            <set:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#0F091A" Padding="25" BorderBrush="#1A112C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="pack://application:,,,/logo.png" Height="100" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="HARDWARE CONFIGURATION SUITE" FontSize="9" Foreground="#666688" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <Button Content="WWW.ANTARTECH.COM.AR" Command="{Binding OpenWebsiteCommand}" 
                            Background="Transparent" BorderThickness="0" Foreground="#FF33CC" FontSize="10" FontWeight="Bold" Cursor="Hand" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Text="DISPOSITIVOS" FontSize="11" FontWeight="SemiBold" Foreground="#8888AA" Grid.Row="1" Margin="0,0,0,15"/>
                
                <ListBox Grid.Row="2" Margin="0,0,0,0" 
                         ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                         Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15" Background="#160E25" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#2A1B44" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#8888AA" Margin="0,2,0,0"/>
                                    <TextBlock FontSize="10" Foreground="#666688" Margin="0,8,0,0">
                                        <Run Text="VID: "/>
                                        <Run Text="{Binding VendorId, StringFormat=X4}" Foreground="#00E5FF"/>
                                        <Run Text=" PID: "/>
                                        <Run Text="{Binding ProductId, StringFormat=X4}" Foreground="#00E5FF"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Margin="0,15,0,0">
                    <Button Content="🏠 DASHBOARD" Command="{Binding NavigateToDashboardCommand}"
                            Background="#160E25" Foreground="#00E5FF" FontWeight="Bold" Padding="15" Margin="0,0,0,10"/>
                    <Button Content="ACTUALIZAR LISTA" Command="{Binding RefreshDevicesCommand}"
                            Background="#160E25" Foreground="#8888AA" FontWeight="SemiBold" Padding="15"/>
                    <Button Content="⚙ CONFIGURACIÓN DE APP" Command="{Binding NavigateToSettingsCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#8888AA" FontSize="11" Padding="15" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Host -->
        <Border Grid.Column="1" Padding="40">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static vm:AppView.Dashboard}">
                                <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static vm:AppView.Calibration}">
                                <Setter Property="ContentTemplate" Value="{StaticResource CalibrationTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="{x:Static vm:AppView.Settings}">
                                <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Window>
