<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    
    <!-- Metadatos de Producción para Windows Explorer y Seguridad -->
    <AssemblyName>AntarTechControl</AssemblyName>
    <AssemblyTitle>Antartech Control Hub</AssemblyTitle>
    <Product>Antartech Control Hub</Product>
    <Company>Antartech Simracing</Company>
    <Authors>Antartech</Authors>
    <Copyright>Copyright © Antartech 2026</Copyright>
    <Description>Software oficial de calibración y configuración para hardware simracing Antartech.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HidLibrary" Version="3.3.40" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
    <Resource Include="logo.png" />
    <Resource Include="logo_crisp.png" />
    <Resource Include="logo_clean_cyan.png" />
    <Resource Include="logo_clean_white.png" />
    <Resource Include="logo_clean_neon.png" />
    <Resource Include="pedals_render.jpg" />
    <Resource Include="pedals_box.png" />
    <Resource Include="logo_badge.png" />
  </ItemGroup>

</Project>
