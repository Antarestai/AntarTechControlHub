<Application x:Class="AntarTechControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AntarTechControl"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ToggleButton Style for Advanced Mode -->
        <Style TargetType="ToggleButton" x:Key="AdvancedToggleStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="#1A112C" BorderBrush="#2A1B44" BorderThickness="1" CornerRadius="6" Padding="15,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⯆" Foreground="#00E5FF" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="Icon"/>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Text" Value="⯅"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#FF33CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FF33CC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- General Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A112C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A1B44"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF33CC"/>
                    <Setter Property="BorderBrush" Value="#FF33CC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Application.Resources>
</Application>
